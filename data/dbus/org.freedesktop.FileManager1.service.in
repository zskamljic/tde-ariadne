# Makes Ariadne the file manager other applications ask to show folders and files, even while
# it is not running. Nautilus installs the same service system-wide, so this one is not
# installed where D-Bus looks; copy it to ~/.local/share/dbus-1/services/, which comes first.
[D-BUS Service]
Name=org.freedesktop.FileManager1
Exec=@CMAKE_INSTALL_FULL_BINDIR@/ariadne --service
